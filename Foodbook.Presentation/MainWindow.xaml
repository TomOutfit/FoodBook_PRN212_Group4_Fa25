<Window x:Class="Foodbook.Presentation.MainWindow" x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewsTabsNs="clr-namespace:Foodbook.Presentation.Views.Tabs"
        xmlns:viewsWinNs="clr-namespace:Foodbook.Presentation.Views"
        Title="🍽️ FoodBook - AI-Powered Recipe Manager" 
        Height="750" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStyle="None"
        AllowsTransparency="False"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top app bar (green) -->
        <Border Grid.Row="0" Background="#43A047" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="HamburgerButton" Content="☰" Width="28" Height="28" Margin="0,0,8,0" Background="Transparent" Foreground="White" BorderThickness="0" Click="HamburgerButton_Click"/>
                    <TextBlock Text="🍳" FontSize="18" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding DataContext.Loc_FoodBook, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <Button Content="⎯" Background="Transparent" Foreground="White" BorderThickness="0" Width="28" Height="28" Click="MinimizeButton_Click"/>
                    <Button Content="□" Background="Transparent" Foreground="White" BorderThickness="0" Width="28" Height="28" Click="MaximizeButton_Click"/>
                    <Button Content="✕" Background="Transparent" Foreground="White" BorderThickness="0" Width="28" Height="28" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Navigation -->
                    <StackPanel Grid.Row="1">
                        <Button Command="{Binding SelectTabCommand}" CommandParameter="Dashboard" Margin="0,4" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Dashboard">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4CAF50" Offset="0"/>
                                                    <GradientStop Color="#43A047" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4CAF50" Direction="270" ShadowDepth="0" Opacity="0.5" BlurRadius="12"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DataContext.Loc_Dashboard, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="🏠" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding DataContext.Loc_Dashboard, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource SidebarVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Recipes" Margin="0,4" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Recipes">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4CAF50" Offset="0"/>
                                                    <GradientStop Color="#43A047" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4CAF50" Direction="270" ShadowDepth="0" Opacity="0.5" BlurRadius="12"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DataContext.Loc_MyRecipes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="📖" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding DataContext.Loc_MyRecipes, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource SidebarVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Ingredients" Margin="0,4" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Ingredients">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4CAF50" Offset="0"/>
                                                    <GradientStop Color="#43A047" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4CAF50" Direction="270" ShadowDepth="0" Opacity="0.5" BlurRadius="12"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DataContext.Loc_Ingredients, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="🥗" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding DataContext.Loc_Ingredients, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource SidebarVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="AI" Margin="0,4" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="AI">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4CAF50" Offset="0"/>
                                                    <GradientStop Color="#43A047" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4CAF50" Direction="270" ShadowDepth="0" Opacity="0.5" BlurRadius="12"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DataContext.Loc_AI, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="🤖" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding DataContext.Loc_AI, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource SidebarVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Analytics" Margin="0,4" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Analytics">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4CAF50" Offset="0"/>
                                                    <GradientStop Color="#43A047" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4CAF50" Direction="270" ShadowDepth="0" Opacity="0.5" BlurRadius="12"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DataContext.Loc_Analytics, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="📊" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding DataContext.Loc_Analytics, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource SidebarVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding SelectTabCommand}" CommandParameter="Settings" Margin="0,4" HorizontalAlignment="Stretch">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Settings">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#4CAF50" Offset="0"/>
                                                    <GradientStop Color="#43A047" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4CAF50" Direction="270" ShadowDepth="0" Opacity="0.5" BlurRadius="12"/>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DataContext.Loc_Settings, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                            <TextBlock Text="⚙️" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding DataContext.Loc_Settings, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource SidebarVisibilityConverter}}"/>
                        </StackPanel>
                    </Button>
                    </StackPanel>

                    <!-- User Card / Logout -->
                    <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0" Margin="0,12,0,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Direction="270" ShadowDepth="2" Opacity="0.06" BlurRadius="12"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Avatar with gradient background -->
                            <Border Width="44" Height="44" CornerRadius="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#4CAF50" Offset="0"/>
                                        <GradientStop Color="#43A047" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#4CAF50" Direction="270" ShadowDepth="0" Opacity="0.3" BlurRadius="8"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding DataContext.CurrentUser.Username, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource FirstLetterConverter}}" 
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                            </Border>

                            <!-- User info -->
                            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                                        Visibility="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource SidebarVisibilityConverter}}">
                                <TextBlock Text="{Binding DataContext.CurrentUser.Username, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding DataContext.CurrentUser.Email, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="7" Margin="0,2,0,0"/>
                            </StackPanel>

                            <!-- Logout button with hover effect -->
                            <Button Grid.Column="2" Width="32" Height="32" BorderThickness="0" 
                                    ToolTip="{Binding DataContext.Loc_Logout, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Click="Logout_Click" Cursor="Hand"
                                    Background="Transparent" Padding="0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" 
                                                            CornerRadius="8" 
                                                            Padding="8"
                                                            BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter Property="Background" Value="#FECACA"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚪" FontSize="16" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main content: 1 view visible at a time via SelectedTab on MainViewModel -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="24,20,0,24" Padding="0,0,24,0">
                <StackPanel>
                    <viewsTabsNs:DashboardView Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Dashboard}"
                                              DataContext="{Binding AnalyticsVM}"/>
                    <viewsTabsNs:RecipesView Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Recipes}"
                                            DataContext="{Binding RecipeListVM}"/>
                    <viewsTabsNs:IngredientsView Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Ingredients}"
                                                DataContext="{Binding InventoryVM}"/>
                    <viewsTabsNs:AIView Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=AI}"
                                       DataContext="{Binding AIVM}"/>
                    <viewsTabsNs:AnalyticsView Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Analytics}"
                                               DataContext="{Binding AnalyticsVM}"/>
                    <viewsTabsNs:SettingsView Visibility="{Binding DataContext.SelectedTab, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Converter={StaticResource TabVisibilityConverter}, ConverterParameter=Settings}"
                                               DataContext="{Binding SettingsVM}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>