<Window x:Class="Foodbook.Presentation.Views.NutritionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Foodbook.Presentation.Converters"
        Title="🍎 Nutrition Analysis"
        Height="750"
        Width="1100"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="Window_Loaded">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Border Background="White" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="MediumAquamarine" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="15,0" VerticalAlignment="Center">
                        <TextBlock Text="🔷" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="🍎 Nutrition Analysis" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Click="MinimizeButton_Click" Cursor="Hand"/>
                        <Button Content="✕" Width="40" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="16" Click="CloseButton_Click" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- New standalone layout -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.42*" MinWidth="420"/>
                    <ColumnDefinition Width="0.58*" MinWidth="520"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Input -->
                <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="0,0,10,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="🥗 Nguồn Dữ liệu &amp; Nhập liệu" FontWeight="Bold" FontSize="18" Margin="0,0,0,16" Foreground="#1F2937"/>

                            <TextBlock Text="Chọn nguồn dữ liệu:" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                            <ComboBox SelectedValue="{Binding SelectedDataSource}" SelectedValuePath="Tag" Height="44" Padding="10" BorderThickness="1" BorderBrush="#D1D5DB" Margin="0,0,0,16">
                                <ComboBoxItem Content="📚 Chọn từ Công thức Đã Lưu" Tag="Database"/>
                                <ComboBoxItem Content="✍️ Nhập Công Thức Mới" Tag="AI"/>
                            </ComboBox>

                            <!-- Database selection -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDataSource}" Value="Database">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Chọn công thức:" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                                <ComboBox ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe}" DisplayMemberPath="Title" Height="44" Padding="10" BorderThickness="1" BorderBrush="#D1D5DB" Margin="0,0,0,16"/>
                            </StackPanel>

                            <!-- Custom recipe input -->
                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedDataSource}" Value="AI">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Nhập công thức:" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding CustomRecipeText}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="140" Padding="12" BorderThickness="1" BorderBrush="#D1D5DB" Margin="0,0,0,16"/>
                            </StackPanel>

                            <TextBlock Text="Mục tiêu sức khỏe:" FontWeight="SemiBold" FontSize="14" Foreground="#374151" Margin="0,0,0,8"/>
                            <ComboBox SelectedValue="{Binding UserGoal}" SelectedValuePath="Tag" Height="44" Padding="10" BorderThickness="1" BorderBrush="#D1D5DB" Margin="0,0,0,20">
                                <ComboBoxItem Content="💪 Sức Khỏe Tổng Quát" Tag="Sức Khỏe Tổng Quát"/>
                                <ComboBoxItem Content="🏃 Giảm Cân" Tag="Giảm Cân"/>
                                <ComboBoxItem Content="💪 Tăng Cơ" Tag="Tăng Cơ"/>
                                <ComboBoxItem Content="❤️ Tim Mạch" Tag="Tim Mạch"/>
                                <ComboBoxItem Content="🧠 Trí Não" Tag="Trí Não"/>
                            </ComboBox>

                            <Button Content="🔍 Phân Tích Dinh Dưỡng" Command="{Binding AnalyzeNutritionCommand}" Background="#10B981" Foreground="White" BorderThickness="0" Padding="18,12" FontWeight="Bold" FontSize="14"/>
                            <Button Content="🗑️ Xóa Kết Quả" Command="{Binding ClearAnalysisCommand}" Background="#6B7280" Foreground="White" BorderThickness="0" Padding="14,10" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right: Results -->
                <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="12" Padding="20" BorderBrush="#E5E7EB" BorderThickness="1" Margin="10,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="📊 Kết quả Phân tích &amp; Đánh giá A.I" FontWeight="Bold" FontSize="18" Margin="0,0,0,12" Foreground="#1F2937"/>

                            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" Margin="0,12">
                                <TextBlock Text="🤖 AI đang phân tích..." FontSize="14" Foreground="#3498DB" HorizontalAlignment="Center"/>
                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Width="200"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Invert}">
                                <!-- Summary tiles -->
                                <Border Background="#F0FDF4" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#BBF7D0">
                                    <WrapPanel ItemWidth="200" MinWidth="200" Margin="-6,0,0,0">
                                        <Border Background="#DCFCE7" CornerRadius="8" Padding="12" Margin="6,0,6,0" Width="200">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TotalCalories, StringFormat='{}{0:F0}'}" FontSize="26" FontWeight="Bold" Foreground="#16A34A" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Calories" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#166534"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#DBEAFE" CornerRadius="8" Padding="12" Margin="6,0,6,0" Width="200">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TotalProtein, StringFormat='{}{0:F1}g'}" FontSize="26" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Protein" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#1E40AF"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FEF3C7" CornerRadius="8" Padding="12" Margin="6,0,6,0" Width="200">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TotalCarbs, StringFormat='{}{0:F1}g'}" FontSize="26" FontWeight="Bold" Foreground="#D97706" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Carbs" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#92400E"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#FEE2E2" CornerRadius="8" Padding="12" Margin="6,0,6,0" Width="200">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TotalFat, StringFormat='{}{0:F1}g'}" FontSize="26" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center"/>
                                                <TextBlock Text="Fat" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="#991B1B"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </Border>

                                <!-- AI Assessment -->
                                <Border Background="#FFFBEB" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#FDE68A">
                                    <StackPanel>
                                        <TextBlock Text="🤖 Đánh Giá A.I" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#92400E"/>
                                        <TextBlock Text="{Binding AIAssessment}" TextWrapping="Wrap" FontSize="14" LineHeight="22" Foreground="#78350F"/>
                                    </StackPanel>
                                </Border>

                                <!-- Health Alerts -->
                                <Border Background="#FEF2F2" CornerRadius="12" Padding="16" Margin="0,0,0,16" BorderThickness="1" BorderBrush="#FECACA">
                                    <StackPanel>
                                        <TextBlock Text="⚠️ Cảnh Báo Sức Khỏe" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#991B1B"/>
                                        <ItemsControl ItemsSource="{Binding HealthAlerts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#FEE2E2">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Icon}" FontSize="16" Margin="0,0,0,6"/>
                                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#991B1B" LineHeight="20"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Recommendations -->
                                <Border Background="#F0F9FF" CornerRadius="12" Padding="16" BorderThickness="1" BorderBrush="#BAE6FD">
                                    <StackPanel>
                                        <TextBlock Text="💡 Khuyến Nghị Dinh Dưỡng" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#0C4A6E"/>
                                        <ItemsControl ItemsSource="{Binding NutritionRecommendations}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#E0F2FE">
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" Foreground="#0C4A6E" LineHeight="20"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>

