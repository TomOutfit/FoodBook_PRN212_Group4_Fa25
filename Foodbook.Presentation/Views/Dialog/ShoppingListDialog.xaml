<Window x:Class="Foodbook.Presentation.Views.ShoppingListDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Foodbook.Presentation.Converters"
        Title="🛒 Smart Shopping List" 
        Height="700" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        
        <Style x:Key="CategoryStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495E"/>
            <Setter Property="Margin" Value="0,15,0,8"/>
        </Style>
        
        <Style x:Key="ItemStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="Margin" Value="20,2,0,2"/>
        </Style>
        
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#F8F9FA"/>
            <Setter Property="BorderBrush" Value="#E9ECEF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </Window.Resources>
    
    <Border Background="White" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>
        
        <Grid>
        <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
            <!-- Top Bar with .NET icon and cart icon -->
            <Border Grid.Row="0" Background="#2C3E50" Height="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Left side: Icons and Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="🔷" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="🛒" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="Smart Shopping List" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="White" 
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Right side: Window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" 
                                Width="40" 
                                Height="40" 
                                Background="Transparent" 
                                Foreground="White" 
                                BorderThickness="0"
                                FontSize="16"
                                Click="MinimizeButton_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#34495E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="□" 
                                Width="40" 
                                Height="40" 
                                Background="Transparent" 
                                Foreground="White" 
                                BorderThickness="0"
                                FontSize="14"
                                Click="MaximizeButton_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#34495E"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="✕" 
                                Width="40" 
                                Height="40" 
                                Background="Transparent" 
                                Foreground="White" 
                                BorderThickness="0"
                                FontSize="16"
                                Click="CloseButton_Click"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E74C3C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Main Header -->
            <StackPanel Grid.Row="1" Margin="20,20,20,15">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="🛒" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Smart Shopping List" Style="{StaticResource HeaderStyle}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Generate and manage your shopping list" 
                       FontSize="12" 
                           Foreground="#7F8C8D"
                           Margin="34,0,0,0"/>
        </StackPanel>
        
        <!-- Content -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="20,0,20,0">
            <StackPanel>
                <!-- Generation Mode Selection -->
                <Border Background="#F0F8FF" 
                        BorderBrush="#3498DB" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15" 
                        Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="🎲 Generation Mode" FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding GenerationModes}" 
                                      SelectedItem="{Binding SelectedGenerationMode, Mode=TwoWay}"
                                      Height="36"
                                      FontSize="13"
                                      Padding="8,0"
                                      Background="White"
                                      BorderBrush="#D1D5DB"
                                      BorderThickness="1"
                                      Margin="0,0,10,0">
                                <ComboBox.ItemContainerStyle>
                                    <Style TargetType="ComboBoxItem">
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button Content="🛒 Generate" 
                                    Grid.Column="1"
                                    Background="#F59E0B" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Padding="20,8"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Command="{Binding GenerateCommand}"
                                    Cursor="Hand"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Ingredient Selection Panel (shown when User List mode and no ingredients selected) -->
                <Border Background="#FFF8E1" 
                        BorderBrush="#FFC107" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15" 
                        Margin="0,0,0,15"
                        Visibility="{Binding ShowIngredientSelection, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🥘 Select Ingredients" FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50"/>
                            <TextBlock Text="{Binding SelectedIngredients.Count, StringFormat=' ({0} selected)'}" 
                                       FontSize="12" 
                                       Foreground="#7F8C8D" 
                                       Margin="5,0,0,0"/>
                        </StackPanel>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 FontSize="12"
                                 Padding="8,0"
                                 Background="White"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding AvailableIngredients}"
                                 SelectionMode="Multiple"
                                 Height="150"
                                 Background="White"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1"
                                 x:Name="IngredientsListBox">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding}" 
                                              IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Confirm Selection" 
                                    Background="#FFC107" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Padding="15,8"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Click="ConfirmIngredientSelection_Click"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Export Options Panel -->
                <Border Background="#E8F5E9" 
                        BorderBrush="#4CAF50" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15" 
                        Margin="0,0,0,15"
                        Visibility="{Binding ShowExportOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="📄 Export Options" FontWeight="SemiBold" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,10"/>
                        <TextBlock Text="Export Type:" FontSize="12" Foreground="#374151" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ExportTypes}" 
                                  SelectedItem="{Binding SelectedExportType, Mode=TwoWay}"
                                  Height="35"
                                  FontSize="13"
                                  Padding="8,0"
                                  Background="White"
                                  BorderBrush="#D1D5DB"
                                  BorderThickness="1"
                                  Margin="0,0,0,10"/>
                        <TextBlock Text="File Name:" FontSize="12" Foreground="#374151" Margin="0,0,0,6"/>
                        <TextBox Text="{Binding ExportFileName, Mode=TwoWay}"
                                 Height="35"
                                 FontSize="13"
                                 Padding="8,0"
                                 Background="White"
                                 BorderBrush="#D1D5DB"
                                 BorderThickness="1"
                                 Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Export" 
                                    Width="90" 
                                    Height="36"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Margin="0,0,10,0"
                                    Click="ConfirmExport_Click"
                                    Cursor="Hand"/>
                            <Button Content="Cancel" 
                                    Width="90" 
                                    Height="36"
                                    Background="#95A5A6"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Click="CancelExport_Click"
                                    Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Search and Filter (only show when list is available) -->
                <Border Background="#F8F9FA" 
                        BorderBrush="#E9ECEF" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="15" 
                        Margin="0,0,0,15"
                        Visibility="{Binding IsListAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="🔍 Search &amp; Filter" FontWeight="SemiBold" FontSize="12" Foreground="#2C3E50" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchTextBox" 
                                     Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" 
                                     Padding="8,6" 
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"/>
                            <Button Content="🔍 Search" 
                                    Grid.Column="1"
                                    Background="#3498DB" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Padding="12,6"
                                    Command="{Binding SearchCommand}"/>
                        </Grid>
                    </StackPanel>
                </Border>
                
                <!-- Summary Cards (only show when list is available) -->
                <Grid Visibility="{Binding IsListAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Total Items -->
                    <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="📦 Total Items" FontWeight="SemiBold" FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="TotalItemsText" 
                                       Text="{Binding TotalItems}" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#2C3E50"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Estimated Cost -->
                    <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="💰 Estimated Cost" FontWeight="SemiBold" FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="EstimatedCostText" 
                                       Text="{Binding EstimatedCost}" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#27AE60"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- Shopping Time -->
                    <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="⏱️ Shopping Time" FontWeight="SemiBold" FontSize="12" Foreground="#7F8C8D"/>
                            <TextBlock x:Name="ShoppingTimeText" 
                                       Text="{Binding ShoppingTime}" 
                                       FontSize="20" 
                                       FontWeight="Bold" 
                                       Foreground="#3498DB"/>
                        </StackPanel>
                    </Border>
                </Grid>
                
                <!-- Categories (only show when list is available) -->
                <TextBlock Text="📋 Shopping Categories" 
                           Style="{StaticResource CategoryStyle}"
                           Visibility="{Binding IsListAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ItemsControl x:Name="CategoriesList" 
                              ItemsSource="{Binding FilteredCategories}"
                              Visibility="{Binding IsListAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FFFFFF" 
                                    BorderBrush="#E9ECEF" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Margin="0,0,0,10" 
                                    Padding="15">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="SemiBold" 
                                               FontSize="14" 
                                               Foreground="#2C3E50"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                                        <TextBlock Text="{Binding ItemCount, StringFormat='{}{0} items'}" 
                                                   FontSize="11" 
                                                   Foreground="#7F8C8D"/>
                                        <TextBlock Text="{Binding CategoryTotal, StringFormat=' - ${0:F2}'}" 
                                                   FontSize="11" 
                                                   Foreground="#27AE60"
                                                   FontWeight="SemiBold"
                                                   Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ShoppingOrder}" 
                                               FontSize="10" 
                                               Foreground="#95A5A6" 
                                               FontStyle="Italic"
                                               Margin="0,0,0,5"/>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <CheckBox Grid.Column="0" 
                                                              IsChecked="{Binding IsChecked}"
                                                              Click="ItemCheckBox_Click"
                                                              Margin="0,0,5,0"/>
                                                    
                                                    <TextBlock Grid.Column="1" 
                                                               Text="{Binding Name}" 
                                                               FontSize="12" 
                                                               Foreground="#2C3E50"
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="2" 
                                                               FontSize="11" 
                                                               Foreground="#7F8C8D" 
                                                               Margin="10,0"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0} {1}">
                                                                <Binding Path="Quantity"/>
                                                                <Binding Path="Unit"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                    
                                                    <TextBlock Grid.Column="3" 
                                                               Text="{Binding EstimatedPrice, StringFormat='{}{0:F2}'}" 
                                                               FontSize="11" 
                                                               FontWeight="SemiBold" 
                                                               Foreground="#27AE60"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Smart Tips Section (only show when list is available) -->
                <Border Background="#F8F9FA" 
                        BorderBrush="#E9ECEF" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,20,0,0"
                        Visibility="{Binding IsListAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="💡 Smart Shopping Tips" 
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Foreground="#2C3E50" 
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="TipsList" ItemsSource="{Binding Tips}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               FontSize="11" 
                                               Foreground="#34495E" 
                                               Margin="0,2" 
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                
                <!-- Store Navigation Section (only show when list is available) -->
                <Border Background="#E8F4FD" 
                        BorderBrush="#3498DB" 
                        BorderThickness="1" 
                        CornerRadius="8" 
                        Padding="15" 
                        Margin="0,10,0,0"
                        Visibility="{Binding IsListAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="🗺️ Store Navigation" 
                                   FontWeight="SemiBold" 
                                   FontSize="14" 
                                   Foreground="#2C3E50" 
                                   Margin="0,0,0,10"/>
                        <ItemsControl x:Name="SuggestionsList" ItemsSource="{Binding StoreSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" 
                                               FontSize="11" 
                                               Foreground="#2980B9" 
                                               Margin="0,2" 
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20,20,20,20">
            <Button Content="📄 Export to File" 
                    Background="#3498DB" 
                    Foreground="White" 
                    BorderThickness="0" 
                    Padding="15,8" 
                    Margin="0,0,10,0"
                    Click="ExportButton_Click"/>
            <Button Content="🖨️ Print List" 
                    Background="#9B59B6" 
                    Foreground="White" 
                    BorderThickness="0" 
                    Padding="15,8" 
                    Margin="0,0,10,0"
                    Click="PrintButton_Click"/>
            <Button Content="✅ Close" 
                    Background="#27AE60" 
                    Foreground="White" 
                    BorderThickness="0" 
                    Padding="15,8"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
