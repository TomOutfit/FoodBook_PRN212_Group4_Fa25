<Window x:Class="Foodbook.Presentation.Views.RecipeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recipe Details" 
        Height="820" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    
    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Background="#4CAF50" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                    <TextBlock Text="🍽️" FontSize="22" Foreground="White"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Recipe Details" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Xem và chỉnh sửa công thức của bạn" FontSize="13" Foreground="#6B7280"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="EditToggleButton" Content="✏️ Edit" Style="{StaticResource ModernButton}" Click="EditToggleButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Body: View panel (left) + Edit form (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- VIEW PANEL -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,16,0">
                <StackPanel>
                    <Border Background="#FFFFFF" CornerRadius="16" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <Border CornerRadius="14" ClipToBounds="True">
                                <Image Source="{Binding ImageUrl}" Height="280" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="🍽️" FontSize="48" Foreground="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ImageUrl, Converter={StaticResource NullToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" CornerRadius="16" Padding="20" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#1F2937" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Description}" FontSize="14" Foreground="#4B5563" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⏱️" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding CookTime, StringFormat={}{0} mins}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="👥" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Servings, StringFormat={}{0} servings}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,0,8,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🧩" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Difficulty}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="#FFFFFF" CornerRadius="16" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Instructions" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Instructions}" TextWrapping="Wrap" Foreground="#374151"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- EDIT FORM -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                <!-- Title -->
                <TextBlock Text="Title *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="TitleTextBox" 
                         Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12" 
                         FontSize="14" 
                         Margin="0,0,0,16"/>

                <!-- Description -->
                <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12" 
                         FontSize="14" 
                         Height="60"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,0,0,16"/>

                <!-- Cook Time and Difficulty -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Cook Time (minutes) *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding CookTime, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="12" 
                                 FontSize="14"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Difficulty *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox SelectedValue="{Binding Difficulty, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  SelectedValuePath="Tag"
                                  Padding="12" 
                                  FontSize="14">
                            <ComboBoxItem Content="Easy" Tag="Easy"/>
                            <ComboBoxItem Content="Medium" Tag="Medium"/>
                            <ComboBoxItem Content="Hard" Tag="Hard"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <!-- Servings -->
                <TextBlock Text="Servings" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Servings, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12" 
                         FontSize="14" 
                         Margin="0,0,0,16"/>

                <!-- Image URL -->
                <TextBlock Text="Image URL" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0"
                             x:Name="ImageUrlTextBox"
                             Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12" 
                             FontSize="14"
                             Margin="0,0,8,0"/>
                    
                    <Button Grid.Column="1"
                            Content="Preview"
                            Style="{StaticResource ModernButton}"
                            Padding="12,8"
                            Click="PreviewImage_Click"/>
                </Grid>
                
                <!-- Image Preview -->
                <Border x:Name="ImagePreviewBorder"
                        Background="#F8FAFC"
                        CornerRadius="8"
                        Padding="8"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Image Preview:" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <Image x:Name="ImagePreview"
                               MaxWidth="200"
                               MaxHeight="150"
                               Stretch="Uniform"/>
                    </StackPanel>
                </Border>

                <!-- Instructions -->
                <TextBlock Text="Instructions *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="InstructionsTextBox"
                         Text="{Binding Instructions, UpdateSourceTrigger=PropertyChanged}"
                         Padding="12" 
                         FontSize="14" 
                         Height="120"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,16"/>

            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Đóng" Background="#6B7280" Foreground="White" Padding="20,12" Margin="8" FontWeight="SemiBold" FontSize="14" Cursor="Hand" Click="CancelButton_Click"/>
            <Button x:Name="SaveButton" Content="Lưu thay đổi" Style="{StaticResource ModernButton}" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>