<Window x:Class="Foodbook.Presentation.Views.GenerateRecipeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🤖 AI Chef - Generate Recipe" 
        Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8F9FA">
    
    <Window.Resources>
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#6B7280"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border Background="#4CAF50" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                    <TextBlock Text="🤖" FontSize="22" Foreground="White"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="AI Chef - Generate Recipe" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Tạo công thức tùy chỉnh từ nguyên liệu trong pantry của bạn" FontSize="13" Foreground="#6B7280"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Available Ingredients Info -->
            <Border Background="#E3F2FD" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="📦 Nguyên liệu có sẵn:" FontWeight="SemiBold" Foreground="#1976D2" Margin="0,0,0,4"/>
                    <TextBlock x:Name="AvailableIngredientsText" 
                               Text="Đang tải..." 
                               FontSize="12" 
                               Foreground="#424242" 
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Dish Name -->
                <TextBlock Text="Tên món ăn (tùy chọn)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16">
                    <TextBox x:Name="DishNameTextBox" 
                             Padding="12" 
                             FontSize="14"/>
                    <TextBlock Text="VD: Bữa tối nhanh, Món chay, Keto-friendly..." 
                               Foreground="#9CA3AF" 
                               FontSize="14"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=DishNameTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=DishNameTextBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="💡 Để trống để AI tự động đặt tên" FontSize="11" Foreground="#6B7280" Margin="0,-12,0,16"/>

                <!-- Servings -->
                <TextBlock Text="Số phần ăn *" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBox x:Name="ServingsTextBox" 
                         Text="4"
                         Padding="12" 
                         FontSize="14" 
                         Margin="0,0,0,16"/>
                <TextBlock Text="💡 Mặc định: 4 phần" FontSize="11" Foreground="#6B7280" Margin="0,-12,0,16"/>

                <!-- Custom Preferences -->
                <TextBlock Text="Yêu cầu tùy chỉnh (tùy chọn)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid Margin="0,0,0,16" Height="100">
                    <TextBox x:Name="PreferencesTextBox" 
                             Padding="12" 
                             FontSize="14" 
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                    <TextBlock Text="VD: Dưới 30 phút, Keto, Món chay, Sử dụng hết ức gà sắp hết hạn..." 
                               Foreground="#9CA3AF" 
                               FontSize="14"
                               Margin="12,8,0,0"
                               VerticalAlignment="Top"
                               TextWrapping="Wrap"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=PreferencesTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Text, ElementName=PreferencesTextBox}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="💡 Nhập các tiêu chí bổ sung để AI tạo công thức phù hợp hơn" FontSize="11" Foreground="#6B7280" Margin="0,-12,0,16"/>

                <!-- Quick Presets -->
                <TextBlock Text="Gợi ý nhanh" FontWeight="SemiBold" Margin="0,8,0,8"/>
                <WrapPanel Margin="0,0,0,16">
                    <Button Content="⚡ Dưới 30 phút" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="12,8" 
                            Margin="0,0,8,8"
                            Click="QuickPreset_Click"
                            Tag="Dưới 30 phút"/>
                    <Button Content="🥗 Món chay" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="12,8" 
                            Margin="0,0,8,8"
                            Click="QuickPreset_Click"
                            Tag="Món chay"/>
                    <Button Content="🥑 Keto" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="12,8" 
                            Margin="0,0,8,8"
                            Click="QuickPreset_Click"
                            Tag="Keto"/>
                    <Button Content="🔥 Cay" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="12,8" 
                            Margin="0,0,8,8"
                            Click="QuickPreset_Click"
                            Tag="Cay"/>
                    <Button Content="🍜 Bữa tối" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="12,8" 
                            Margin="0,0,8,8"
                            Click="QuickPreset_Click"
                            Tag="Bữa tối"/>
                </WrapPanel>

                <!-- Loading/Status -->
                <Border x:Name="StatusBorder" 
                        Background="#FFF3CD" 
                        CornerRadius="8" 
                        Padding="12" 
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" 
                                   Text="Đang tạo công thức..." 
                                   FontSize="13" 
                                   Foreground="#856404"/>
                        <TextBlock x:Name="LoadingDots" 
                                   Text="..." 
                                   FontSize="13" 
                                   Foreground="#856404"
                                   Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" 
                    Style="{StaticResource SecondaryButton}" 
                    Click="CancelButton_Click"/>
            <Button x:Name="GenerateButton" 
                    Content="✨ Generate Recipe" 
                    Style="{StaticResource ModernButton}" 
                    Click="GenerateButton_Click"
                    IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>

