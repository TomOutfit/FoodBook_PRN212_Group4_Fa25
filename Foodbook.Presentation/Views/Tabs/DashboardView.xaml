<UserControl x:Class="Foodbook.Presentation.Views.Tabs.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="🍽️ Dashboard" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <Button Grid.Column="1" Content="🔄 Refresh" Padding="12,6" Margin="8,0,0,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding RefreshDashboardCommand}"/>
        </Grid>

        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="0,0,8,0">
                <Border.Effect>
                    <DropShadowEffect Color="#FF6B6B" Direction="270" ShadowDepth="4" Opacity="0.1" BlurRadius="10"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📚" FontSize="22" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding MyTotalRecipes}" FontSize="26" FontWeight="Bold" Foreground="#FF6B6B" HorizontalAlignment="Center"/>
                    <TextBlock Text="Recipes" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Border Height="6" Background="#F3F4F6" CornerRadius="3" Margin="0,8,0,0">
                        <Border Background="#FF6B6B" CornerRadius="3" Width="64"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="8,0">
                <Border.Effect>
                    <DropShadowEffect Color="#4ECDC4" Direction="270" ShadowDepth="4" Opacity="0.1" BlurRadius="10"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🥕" FontSize="22" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TotalIngredients}" FontSize="26" FontWeight="Bold" Foreground="#4ECDC4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Ingredients" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Border Height="6" Background="#F3F4F6" CornerRadius="3" Margin="0,8,0,0">
                        <Border Background="#4ECDC4" CornerRadius="3" Width="64"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="8,0">
                <Border.Effect>
                    <DropShadowEffect Color="#FFA726" Direction="270" ShadowDepth="4" Opacity="0.1" BlurRadius="10"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⏰" FontSize="22" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ExpiringSoonCount}" FontSize="26" FontWeight="Bold" Foreground="#FFA726" HorizontalAlignment="Center"/>
                    <TextBlock Text="Expiring Soon" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Border Height="6" Background="#F3F4F6" CornerRadius="3" Margin="0,8,0,0">
                        <Border Background="#FFA726" CornerRadius="3" Width="64"/>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="20" Margin="8,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#E53935" Direction="270" ShadowDepth="4" Opacity="0.1" BlurRadius="10"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="⚠️" FontSize="22" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ExpiredCount}" FontSize="26" FontWeight="Bold" Foreground="#E53935" HorizontalAlignment="Center"/>
                    <TextBlock Text="Expired" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    <Border Height="6" Background="#F3F4F6" CornerRadius="3" Margin="0,8,0,0">
                        <Border Background="#E53935" CornerRadius="3" Width="64"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" Grid.Column="0" CornerRadius="12" Padding="12" Margin="0,0,8,8">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="MediumVioletRed" Offset="0"/>
                        <GradientStop Color="#FFBBAD66" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#4CAF50" Direction="270" ShadowDepth="12" Opacity="0.4" BlurRadius="25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="📊 Pantry Overview" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    <StackPanel Margin="0,0,0,8">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="In Stock" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="20" CornerRadius="10" Background="#4CAF50" Margin="8,0" HorizontalAlignment="Left">
                                <Border.Width>
                                    <Binding Path="PantryCoveragePercent" Converter="{StaticResource CountToWidthConverter}"/>
                                </Border.Width>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding PantryCoveragePercent, StringFormat={}{0}%}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Expiring" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="20" CornerRadius="10" Background="#FFA726" Margin="8,0" HorizontalAlignment="Left">
                                <Border.Width>
                                    <Binding Path="ExpiringSoonCount" Converter="{StaticResource CountToWidthConverter}"/>
                                </Border.Width>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding ExpiringSoonCount}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Expired" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="20" CornerRadius="10" Background="#F44336" Margin="8,0" HorizontalAlignment="Left">
                                <Border.Width>
                                    <Binding Path="ExpiredCount" Converter="{StaticResource CountToWidthConverter}"/>
                                </Border.Width>
                            </Border>
                            <TextBlock Grid.Column="2" FontSize="14" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding ExpiredCount}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Padding="12" Margin="8,8,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#f093fb" Offset="0"/>
                        <GradientStop Color="#f5576c" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#f093fb" Direction="270" ShadowDepth="12" Opacity="0.4" BlurRadius="25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🍎 Top Ingredients This Week" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    <Grid Height="120" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="6,0" ToolTip="{Binding TopIngredients[0].Key, StringFormat=Ingredient: {0}}">
                            <Border CornerRadius="6,6,0,0" Background="#FF6B6B" Margin="0,0,0,8">
                                <Border.Height>
                                    <Binding Path="TopIngredients[0].Value" Converter="{StaticResource CountToHeightConverter}"/>
                                </Border.Height>
                            </Border>
                            <TextBlock Text="{Binding TopIngredients[0].Key}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="6,0" ToolTip="{Binding TopIngredients[1].Key, StringFormat=Ingredient: {0}}">
                            <Border CornerRadius="6,6,0,0" Background="#4CAF50" Margin="0,0,0,8">
                                <Border.Height>
                                    <Binding Path="TopIngredients[1].Value" Converter="{StaticResource CountToHeightConverter}"/>
                                </Border.Height>
                            </Border>
                            <TextBlock Text="{Binding TopIngredients[1].Key}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="6,0" ToolTip="{Binding TopIngredients[2].Key, StringFormat=Ingredient: {0}}">
                            <Border CornerRadius="6,6,0,0" Background="#9C27B0" Margin="0,0,0,8">
                                <Border.Height>
                                    <Binding Path="TopIngredients[2].Value" Converter="{StaticResource CountToHeightConverter}"/>
                                </Border.Height>
                            </Border>
                            <TextBlock Text="{Binding TopIngredients[2].Key}" FontSize="12" Foreground="White" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
